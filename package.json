{
  "name": "pastel-term",
  "version": "1.0.0",
  "description": "Petal: a calm, readable pastel terminal for Claude Code",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w node-pty",
    "contrast": "node scripts/check-contrast.mjs",
    "snapshot": "PASTEL_SNAPSHOT=1 electron .",
    "package": "electron-packager . \"Petal\" --platform=darwin --arch=arm64 --out=dist.noindex --overwrite --asar.unpack=\"**/node_modules/node-pty/**\" --ignore=\"^/dist\" --ignore=\"^/scripts\" --app-bundle-id=local.petal --icon=build/icon.icns"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.4.5"
  },
  "productName": "Petal",
  "private": true
}
