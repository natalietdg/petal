{
  "name": "pastel-term",
  "version": "1.0.6",
  "description": "Petal: a calm, readable pastel terminal for Claude Code",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-rebuild -f -w node-pty",
    "contrast": "node scripts/check-contrast.mjs",
    "snapshot": "electron-vite build && PASTEL_SNAPSHOT=1 electron .",
    "package": "electron-vite build && electron-builder --mac --dir --universal --publish never",
    "dist": "electron-vite build && electron-builder --mac --publish never",
    "lint": "eslint .",
    "release": "scripts/release.sh",
    "test": "vitest run",
    "package:local": "[ -n \"$CSC_NAME\" ] || { echo 'package:local needs CSC_NAME, e.g. CSC_NAME=\"Apple Development: <you> (<id>)\" npm run package:local' >&2; exit 1; } && electron-vite build && electron-builder --mac --dir --universal --publish never -c.mac.identity=\"$CSC_NAME\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^24.19.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "productName": "Petal",
  "private": true
}
