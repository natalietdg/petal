{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]
  },
  "include": ["src/main/**/*.ts", "src/dev/**/*.ts", "test/**/*.ts", "vitest.config.ts", "src/preload.ts", "src/shared/**/*.ts", "electron.vite.config.ts"],
  "exclude": ["test/renderer/**"]
}
